# Copia este archivo a .env y ajusta los valores. .env NO se commitea.
POSTGRES_DB=student_hub
POSTGRES_USER=student_hub
POSTGRES_PASSWORD=student_
# Puerto del host que se mapea al 5432 del contenedor
DB_PORT=5432
# Puerto del host que se mapea al 8080 de la aplicación (cámbialo si 8080 está ocupado)
APP_PORT=8080
# Misma zona horaria en db y app
TZ=America/Bogota
